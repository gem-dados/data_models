config {
    type: "table",
    description: "Normaliza raw.skill_assessments. Padroniza strings e remove nulos críticos.",
    assertions: {
        nonNull: ["useremail"],
        uniqueKey: ["useremail", "assessment_slug"]
    }
}

SELECT
  -- Padronização de Strings
  LOWER(TRIM(SAFE_CAST(email AS STRING))) AS useremail,
  TRIM(SAFE_CAST(username AS STRING)) AS username,
  TRIM(SAFE_CAST(teams AS STRING)) AS teams,
  TRIM(SAFE_CAST(assessment_name AS STRING)) AS assessment_name,
  TRIM(SAFE_CAST(assessment_slug AS STRING)) AS assessment_slug,
  SAFE_CAST(date_started AS TIMESTAMP) AS date_started,
  SAFE_CAST(date_completed AS TIMESTAMP) AS date_completed,
  SAFE_CAST(reported_score AS INT64) AS reported_score,
  SAFE_CAST(reported_percentile AS INT64) AS reported_percentile,
  TRIM(SAFE_CAST(reported_knowledge_level AS STRING)) AS reported_knowledge_level,
  SAFE_CAST(attempt_number AS INT64) AS attempt_number,
  CURRENT_TIMESTAMP() AS loaded_at
FROM
  ${ref("raw_skill_assessments")}
  -- Remoção de valores nulos críticos
WHERE
  email IS NOT NULL
  AND TRIM(email) <> ""
