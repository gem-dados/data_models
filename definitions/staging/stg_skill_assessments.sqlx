config {
  type: "table",
  description: "Normaliza raw.skill_assessments. Avaliações de proficiência técnica dos usuários, 100% livre de PII.",
  columns: {
    user_id: "Identificador único anonimizado do usuário (SHA-256)",
    teams: "Equipes ou turmas associadas ao usuário",
    assessment_name: "Nome da avaliação de habilidade",
    assessment_slug: "Identificador único (slug) da avaliação",
    date_started: "Timestamp de início da avaliação",
    date_completed: "Timestamp de finalização da avaliação",
    reported_score: "Pontuação obtida na avaliação (0 a 300+)",
    reported_percentile: "Percentil de desempenho obtido",
    reported_knowledge_level: "Nível de conhecimento alcançado (ex: Beginner, Intermediate, Advanced)",
    attempt_number: "Número da tentativa realizada pelo usuário",
    loaded_at: "Timestamp de carga do registro na camada staging"
  },
  assertions: {
    nonNull: ["user_id", "assessment_slug", "attempt_number"],
    uniqueKey: ["user_id", "assessment_slug", "attempt_number"]
  }
}

SELECT
  TRIM(SAFE_CAST(user_id AS STRING)) AS user_id,
  TRIM(SAFE_CAST(teams AS STRING)) AS teams,
  TRIM(SAFE_CAST(assessment_name AS STRING)) AS assessment_name,
  TRIM(SAFE_CAST(assessment_slug AS STRING)) AS assessment_slug,
  SAFE_CAST(date_started AS TIMESTAMP) AS date_started,
  SAFE_CAST(date_completed AS TIMESTAMP) AS date_completed,
  SAFE_CAST(reported_score AS INT64) AS reported_score,
  SAFE_CAST(reported_percentile AS INT64) AS reported_percentile,
  TRIM(SAFE_CAST(reported_knowledge_level AS STRING)) AS reported_knowledge_level,
  SAFE_CAST(attempt_number AS INT64) AS attempt_number,
  CURRENT_TIMESTAMP() AS loaded_at
FROM
  ${ref("raw_skill_assessments")}
WHERE
  user_id IS NOT NULL
  AND TRIM(user_id) <> ""
  AND assessment_slug IS NOT NULL
  AND attempt_number IS NOT NULL
