config {
    type: "view",
    schema: "staging",
    description: "Normaliza raw.members. Padroniza strings e remove nulos críticos.",
    assertions: {
        nonNull: ["useremail"],
        uniqueKey: ["useremail"]
    }
}

SELECT
  -- Padronização de Strings
  LOWER(TRIM(CAST(email AS STRING))) AS useremail,
  INITCAP(TRIM(CAST(name AS STRING))) AS name,
  TRIM(CAST(teams AS STRING)) AS teams,
  TRIM(CAST(role AS STRING)) AS role,
  TRIM(CAST(learn_license AS STRING)) AS learn_license,
  TRIM(CAST(workspace_license AS STRING)) AS workspace_license,
  CURRENT_TIMESTAMP() AS loaded_at
FROM
  ${ref("raw_members")}
  -- Remoção de valores nulos críticos
WHERE
  email IS NOT NULL
  AND TRIM(email) <> ""
