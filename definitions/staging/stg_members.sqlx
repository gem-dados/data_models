config {
    type: "table",
    description: "Normaliza raw.members. Padroniza strings e remove nulos críticos.",
    assertions: {
        nonNull: ["useremail"],
        uniqueKey: ["useremail"]
    }
}

SELECT
  -- Padronização de Strings
  LOWER(TRIM(SAFE_CAST(email AS STRING))) AS useremail,
  INITCAP(TRIM(SAFE_CAST(name AS STRING))) AS name,
  TRIM(SAFE_CAST(teams AS STRING)) AS teams,
  TRIM(SAFE_CAST(role AS STRING)) AS role,
  TRIM(SAFE_CAST(learn_license AS STRING)) AS learn_license,
  TRIM(SAFE_CAST(workspace_license AS STRING)) AS workspace_license,
  CURRENT_TIMESTAMP() AS loaded_at
FROM
  ${ref("raw_members")}
  -- Remoção de valores nulos críticos
WHERE
  email IS NOT NULL
  AND TRIM(email) <> ""
