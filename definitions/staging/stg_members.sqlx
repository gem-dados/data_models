config {
  type: "table",
  description: "Normaliza raw.members. Cadastro de membros e licenças da organização, 100% livre de PII.",
  columns: {
    user_id: "Identificador único anonimizado do membro (SHA-256)",
    teams: "Equipes ou turmas associadas ao membro",
    role: "Papel/função do membro na plataforma (ex: student, admin)",
    learn_license: "Tipo de licença de aprendizado atribuída",
    workspace_license: "Tipo de licença de workspace atribuída",
    loaded_at: "Timestamp de carga do registro na camada staging"
  },
  assertions: {
    nonNull: ["user_id"],
    uniqueKey: ["user_id"]
  }
}

SELECT
  TRIM(SAFE_CAST(user_id AS STRING)) AS user_id,
  TRIM(SAFE_CAST(teams AS STRING)) AS teams,
  TRIM(SAFE_CAST(role AS STRING)) AS role,
  TRIM(SAFE_CAST(learn_license AS STRING)) AS learn_license,
  TRIM(SAFE_CAST(workspace_license AS STRING)) AS workspace_license,
  CURRENT_TIMESTAMP() AS loaded_at
FROM
  ${ref("raw_members")}
WHERE
  user_id IS NOT NULL
  AND TRIM(user_id) <> ""
