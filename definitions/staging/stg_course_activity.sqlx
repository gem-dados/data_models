config {
    type: "table",
    description: "Normaliza raw.course_activity. Padroniza strings e remove nulos críticos.",
    assertions: {
        nonNull: ["useremail"],
        uniqueKey: ["useremail", "courseid"]
    }
}

SELECT
  -- Padronização de Strings
  INITCAP(TRIM(SAFE_CAST(firstname AS STRING))) AS firstname,
  INITCAP(TRIM(SAFE_CAST(lastname AS STRING))) AS lastname,
  LOWER(TRIM(SAFE_CAST(useremail AS STRING))) AS useremail,
  TRIM(SAFE_CAST(username AS STRING)) AS username,
  TRIM(SAFE_CAST(teams AS STRING)) AS teams,
  SAFE_CAST(REGEXP_REPLACE(joinedgroup, r'\.\d+Z$', 'Z') AS TIMESTAMP) AS joinedgroup,
  SAFE_CAST(REGEXP_REPLACE(leftgroup, r'\.\d+Z$', 'Z') AS TIMESTAMP) AS leftgroup,
  SAFE_CAST(courseid AS INT64) AS courseid,
  TRIM(SAFE_CAST(coursename AS STRING)) AS coursename,
  TRIM(SAFE_CAST(technology AS STRING)) AS technology,
  SAFE_CAST(startedcourse AS TIMESTAMP) AS startedcourse,
  SAFE_CAST(finishedcourse AS TIMESTAMP) AS finishedcourse,
  TRIM(SAFE_CAST(skippedcourse AS STRING)) AS skippedcourse,
  SAFE_CAST(lastvisitedcourse AS TIMESTAMP) AS lastvisitedcourse,
  SAFE_CAST(completedcourseexercises AS INT64) AS completedcourseexercises,
  SAFE_CAST(coursecompletionrate AS FLOAT64) AS coursecompletionrate,
  TRIM(SAFE_CAST(coursestatus AS STRING)) AS coursestatus,
  SAFE_CAST(totalcoursexpearned AS INT64) AS totalcoursexpearned,
  SAFE_CAST(totalcoursexpavailable AS INT64) AS totalcoursexpavailable,
  SAFE_CAST(xpscore AS FLOAT64) AS xpscore,
  TRIM(SAFE_CAST(coursestate AS STRING)) AS coursestate,
  CURRENT_TIMESTAMP() AS loaded_at
FROM
  ${ref("raw_course_activity")}
  -- Remoção de valores nulos críticos
WHERE
  useremail IS NOT NULL
  AND TRIM(useremail) <> ""
