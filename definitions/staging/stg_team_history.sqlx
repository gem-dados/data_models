config {
  type: "table",
  description: "Normaliza raw.team_history. Histórico de eventos e alterações nas equipes da organização.",
  columns: {
    eventtime: "Timestamp do evento ocorrido na equipe",
    eventtype: "Tipo do evento (ex: added, removed, role_changed)",
    eventtargettype: "Tipo de alvo do evento (ex: user, team)",
    teamdata: "Identificador ou dados da equipe relacionada",
    userdata: "Identificador ou dados do usuário envolvido no evento",
    loaded_at: "Timestamp de carga do registro na camada staging"
  },
  assertions: {
    nonNull: ["userdata", "eventtime", "eventtype"],
    uniqueKey: ["userdata", "eventtime", "eventtype"]
  }
}

SELECT
  SAFE_CAST(REGEXP_REPLACE(eventtime, r'\.\d+Z$', 'Z') AS TIMESTAMP) AS eventtime,
  TRIM(SAFE_CAST(eventtype AS STRING)) AS eventtype,
  TRIM(SAFE_CAST(eventtargettype AS STRING)) AS eventtargettype,
  TRIM(SAFE_CAST(teamdata AS STRING)) AS teamdata,
  TRIM(SAFE_CAST(userdata AS STRING)) AS userdata,
  CURRENT_TIMESTAMP() AS loaded_at
FROM
  ${ref("raw_team_history")}
WHERE
  userdata IS NOT NULL
  AND TRIM(userdata) <> ""
  AND eventtime IS NOT NULL
