config {
  type: "table",
  description: "Normaliza raw.content_catalog. Catálogo de cursos, projetos e trilhas disponíveis.",
  columns: {
    id: "Identificador único do conteúdo no catálogo",
    type: "Tipo do conteúdo (ex: course, project, track)",
    title: "Título do conteúdo educacional",
    description: "Descrição detalhada do conteúdo",
    url: "URL de acesso ao conteúdo na plataforma",
    technology: "Tecnologia principal associada (ex: Python, SQL, R)",
    topic: "Tópico temático (ex: Data Engineering, Machine Learning)",
    skill_level: "Nível de habilidade exigido (ex: Beginner, Intermediate, Advanced)",
    hours: "Carga horária estimada em horas",
    state: "Estado do conteúdo (ex: active, archived)",
    mobile: "Booleano indicando suporte em dispositivos móveis",
    releasedat: "Timestamp de publicação do conteúdo",
    lastupdatedat: "Timestamp da última atualização do conteúdo",
    loaded_at: "Timestamp de carga do registro na camada staging"
  },
  assertions: {
    nonNull: ["id"],
    uniqueKey: ["id"]
  }
}

SELECT
  TRIM(SAFE_CAST(id AS STRING)) AS id,
  TRIM(SAFE_CAST(type AS STRING)) AS type,
  TRIM(SAFE_CAST(title AS STRING)) AS title,
  TRIM(SAFE_CAST(description AS STRING)) AS description,
  TRIM(SAFE_CAST(url AS STRING)) AS url,
  TRIM(SAFE_CAST(technology AS STRING)) AS technology,
  TRIM(SAFE_CAST(topic AS STRING)) AS topic,
  TRIM(SAFE_CAST(skill_level AS STRING)) AS skill_level,
  SAFE_CAST(hours AS FLOAT64) AS hours,
  TRIM(SAFE_CAST(state AS STRING)) AS state,
  SAFE_CAST(mobile AS BOOL) AS mobile,
  SAFE_CAST(releasedat AS TIMESTAMP) AS releasedat,
  SAFE_CAST(lastupdatedat AS TIMESTAMP) AS lastupdatedat,
  CURRENT_TIMESTAMP() AS loaded_at
FROM
  ${ref("raw_content_catalog")}
WHERE
  id IS NOT NULL
  AND TRIM(SAFE_CAST(id AS STRING)) <> ""
