config {
  type: "table",
  description: "Normaliza raw.program_activity. Progresso dos usuários em trilhas/programas de aprendizagem, 100% livre de PII.",
  columns: {
    user_id: "Identificador único anonimizado do usuário (SHA-256)",
    teams: "Equipes ou turmas associadas ao usuário",
    trackid: "Identificador numérico da trilha/programa",
    trackversionid: "Identificador da versão da trilha",
    tracktitle: "Título da trilha de aprendizagem",
    technology: "Tecnologia principal da trilha",
    startedat: "Timestamp de início da trilha",
    completedat: "Timestamp de conclusão da trilha",
    pct_xp_earned: "Percentual de XP obtido na trilha",
    hours_spent: "Horas dedicadas à trilha",
    numcourses: "Quantidade total de cursos na trilha",
    numcoursescompleted: "Quantidade de cursos concluídos na trilha",
    numchapters: "Quantidade total de capítulos na trilha",
    numchapterscompleted: "Quantidade de capítulos concluídos na trilha",
    numprojects: "Quantidade de projetos associados à trilha",
    numprojectscompleted: "Quantidade de projetos concluídos",
    numassessments: "Quantidade de avaliações na trilha",
    numassessmentscompleted: "Quantidade de avaliações concluídas",
    loaded_at: "Timestamp de carga do registro na camada staging"
  },
  assertions: {
    nonNull: ["user_id", "trackid"],
    uniqueKey: ["user_id", "trackid"]
  }
}

SELECT
  TRIM(SAFE_CAST(user_id AS STRING)) AS user_id,
  TRIM(SAFE_CAST(teams AS STRING)) AS teams,
  SAFE_CAST(trackid AS INT64) AS trackid,
  SAFE_CAST(trackversionid AS INT64) AS trackversionid,
  TRIM(SAFE_CAST(tracktitle AS STRING)) AS tracktitle,
  TRIM(SAFE_CAST(technology AS STRING)) AS technology,
  SAFE_CAST(startedat AS TIMESTAMP) AS startedat,
  SAFE_CAST(completedat AS TIMESTAMP) AS completedat,
  SAFE_CAST(REPLACE(CAST(pct_xp_earned AS STRING), '%', '') AS INT64) AS pct_xp_earned,
  SAFE_CAST(hours_spent AS FLOAT64) AS hours_spent,
  SAFE_CAST(numcourses AS INT64) AS numcourses,
  SAFE_CAST(numcoursescompleted AS INT64) AS numcoursescompleted,
  SAFE_CAST(numchapters AS INT64) AS numchapters,
  SAFE_CAST(numchapterscompleted AS INT64) AS numchapterscompleted,
  SAFE_CAST(numprojects AS INT64) AS numprojects,
  SAFE_CAST(numprojectscompleted AS INT64) AS numprojectscompleted,
  SAFE_CAST(numassessments AS INT64) AS numassessments,
  SAFE_CAST(numassessmentscompleted AS INT64) AS numassessmentscompleted,
  CURRENT_TIMESTAMP() AS loaded_at
FROM
  ${ref("raw_program_activity")}
WHERE
  user_id IS NOT NULL
  AND TRIM(user_id) <> ""
  AND trackid IS NOT NULL
