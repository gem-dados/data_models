config {
  type: "table",
  description: "Normaliza raw.summary. Resumo consolidado de atividades, XP e conclusões por usuário, 100% livre de PII.",
  columns: {
    user_id: "Identificador único anonimizado do usuário (SHA-256)",
    teams: "Equipes ou turmas associadas ao usuário",
    dateuserjoinedgroup: "Data de entrada do usuário no grupo",
    dateuserleftgroup: "Data de saída do usuário do grupo",
    totalxp: "Total acumulado de pontos de experiência (XP)",
    dateoflastxpearned: "Timestamp do último XP obtido",
    numexercisescompleted: "Quantidade total de exercícios completados",
    numchapterscompleted: "Quantidade total de capítulos completados",
    numcoursescompleted: "Quantidade total de cursos completados",
    numtrackscompleted: "Quantidade total de trilhas completadas",
    numpractisescompleted: "Quantidade total de práticas completadas",
    numprojectscompleted: "Quantidade total de projetos completados",
    numassessmentscompleted: "Quantidade total de avaliações completadas",
    completedcourses: "Lista de cursos completados",
    completedtracks: "Lista de trilhas completadas",
    completedpractises: "Lista de práticas completadas",
    completedprojects: "Lista de projetos completados",
    completedassessments: "Lista de avaliações completadas",
    loaded_at: "Timestamp de carga do registro na camada staging"
  },
  assertions: {
    nonNull: ["user_id"],
    uniqueKey: ["user_id"]
  }
}

SELECT
  TRIM(SAFE_CAST(user_id AS STRING)) AS user_id,
  TRIM(SAFE_CAST(teams AS STRING)) AS teams,
  SAFE_CAST(REGEXP_REPLACE(dateuserjoinedgroup, r'\.\d+Z$', 'Z') AS TIMESTAMP) AS dateuserjoinedgroup,
  SAFE_CAST(REGEXP_REPLACE(dateuserleftgroup, r'\.\d+Z$', 'Z') AS TIMESTAMP) AS dateuserleftgroup,
  SAFE_CAST(totalxp AS INT64) AS totalxp,
  SAFE_CAST(dateoflastxpearned AS TIMESTAMP) AS dateoflastxpearned,
  SAFE_CAST(numexercisescompleted AS INT64) AS numexercisescompleted,
  SAFE_CAST(numchapterscompleted AS INT64) AS numchapterscompleted,
  SAFE_CAST(numcoursescompleted AS INT64) AS numcoursescompleted,
  SAFE_CAST(numtrackscompleted AS INT64) AS numtrackscompleted,
  SAFE_CAST(numpractisescompleted AS INT64) AS numpractisescompleted,
  SAFE_CAST(numprojectscompleted AS INT64) AS numprojectscompleted,
  SAFE_CAST(numassessmentscompleted AS INT64) AS numassessmentscompleted,
  TRIM(SAFE_CAST(completedcourses AS STRING)) AS completedcourses,
  TRIM(SAFE_CAST(completedtracks AS STRING)) AS completedtracks,
  TRIM(SAFE_CAST(completedpractises AS STRING)) AS completedpractises,
  TRIM(SAFE_CAST(completedprojects AS STRING)) AS completedprojects,
  TRIM(SAFE_CAST(completedassessments AS STRING)) AS completedassessments,
  CURRENT_TIMESTAMP() AS loaded_at
FROM
  ${ref("raw_summary")}
WHERE
  user_id IS NOT NULL
  AND TRIM(user_id) <> ""
