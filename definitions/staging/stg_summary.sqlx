config {
    type: "table",
    description: "Normaliza raw.summary. Padroniza strings e remove nulos críticos.",
    assertions: {
        nonNull: ["useremail"],
        uniqueKey: ["useremail"]
    }
}

SELECT
  -- Padronização de Strings
  INITCAP(TRIM(SAFE_CAST(firstname AS STRING))) AS firstname,
  INITCAP(TRIM(SAFE_CAST(lastname AS STRING))) AS lastname,
  LOWER(TRIM(SAFE_CAST(useremail AS STRING))) AS useremail,
  TRIM(SAFE_CAST(username AS STRING)) AS username,
  TRIM(SAFE_CAST(teams AS STRING)) AS teams,
  SAFE_CAST(dateuserjoinedgroup AS TIMESTAMP) AS dateuserjoinedgroup,
  SAFE_CAST(dateuserleftgroup AS TIMESTAMP) AS dateuserleftgroup,
  SAFE_CAST(totalxp AS INT64) AS totalxp,
  SAFE_CAST(dateoflastxpearned AS TIMESTAMP) AS dateoflastxpearned,
  SAFE_CAST(numexercisescompleted AS INT64) AS numexercisescompleted,
  SAFE_CAST(numchapterscompleted AS INT64) AS numchapterscompleted,
  SAFE_CAST(numcoursescompleted AS INT64) AS numcoursescompleted,
  SAFE_CAST(numtrackscompleted AS INT64) AS numtrackscompleted,
  SAFE_CAST(numpractisescompleted AS INT64) AS numpractisescompleted,
  SAFE_CAST(numprojectscompleted AS INT64) AS numprojectscompleted,
  SAFE_CAST(numassessmentscompleted AS INT64) AS numassessmentscompleted,
  TRIM(SAFE_CAST(completedcourses AS STRING)) AS completedcourses,
  TRIM(SAFE_CAST(completedtracks AS STRING)) AS completedtracks,
  TRIM(SAFE_CAST(completedpractises AS STRING)) AS completedpractises,
  TRIM(SAFE_CAST(completedprojects AS STRING)) AS completedprojects,
  TRIM(SAFE_CAST(completedassessments AS STRING)) AS completedassessments,
  CURRENT_TIMESTAMP() AS loaded_at
FROM
  ${ref("raw_summary")}
  -- Remoção de valores nulos críticos
WHERE
  useremail IS NOT NULL
  AND TRIM(useremail) <> ""
