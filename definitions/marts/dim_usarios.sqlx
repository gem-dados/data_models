config {
  type: "table",
  description: "Dimensão cadastral de usuários, contendo uma linha por usuário e seus principais atributos cadastrais.",
  assertions: {
    uniqueKey: ["useremail"],
    nonNull: ["useremail"]
  }
}

WITH usuarios AS (

  SELECT
    useremail,
    name,
    teams,
    role,
    learn_license,
    workspace_license
  FROM ${ref("stg_members")}
  WHERE useremail IS NOT NULL

),

periodo_usuario AS (

  SELECT
    useremail,
    MIN(dateuserjoinedgroup) AS dateuserjoinedgroup,
    MAX(dateuserleftgroup) AS dateuserleftgroup
  FROM ${ref("stg_summary")}
  WHERE useremail IS NOT NULL
  GROUP BY useremail

)

SELECT
  u.useremail,
  u.name,
  u.teams,
  u.role,
  u.learn_license,
  u.workspace_license,
  p.dateuserjoinedgroup,
  p.dateuserleftgroup,

  CASE
    WHEN p.dateuserleftgroup IS NULL THEN "active"
    ELSE "inactive"
  END AS user_status

FROM usuarios u

LEFT JOIN periodo_usuario p
  ON u.useremail = p.useremail