config {
  type: "table",
  schema: "marts",
  description: "Mart analítico agregado semanal para consumo da ferramenta de BI (Looker Studio / Power BI).",
  columns: {
    semana_inicio: "Data de início da semana de atividade (segunda-feira)",
    alunos_ativos_semana: "Quantidade de alunos distintos com atividade na semana",
    xp_total_semana: "Soma total de pontos de experiência gerados na semana",
    media_xp_por_aluno_semana: "Média de XP por aluno ativo na semana",
    cursos_concluidos_semana: "Total de cursos concluídos na semana",
    trilhas_concluidas_semana: "Total de trilhas concluídas na semana"
  },
  assertions: {
    uniqueKey: ["semana_inicio"],
    nonNull: ["semana_inicio"]
  }
}

WITH base_cursos AS (
  SELECT
    DATE_TRUNC(DATE(startedcourse), WEEK(MONDAY)) AS semana_inicio,
    user_id,
    totalcoursexpearned,
    is_completed
  FROM ${ref("fct_progresso_cursos")}
  WHERE startedcourse IS NOT NULL
),

base_trilhas AS (
  SELECT
    DATE_TRUNC(DATE(startedat), WEEK(MONDAY)) AS semana_inicio,
    user_id,
    is_completed
  FROM ${ref("fct_progresso_trilhas")}
  WHERE startedat IS NOT NULL
),

usuarios_ativos_semana AS (
  SELECT semana_inicio, user_id FROM base_cursos
  UNION DISTINCT
  SELECT semana_inicio, user_id FROM base_trilhas
),

metricas_alunos AS (
  SELECT
    semana_inicio,
    COUNT(DISTINCT user_id) AS alunos_ativos_semana
  FROM usuarios_ativos_semana
  WHERE semana_inicio IS NOT NULL
  GROUP BY semana_inicio
),

metricas_cursos AS (
  SELECT
    semana_inicio,
    COALESCE(SUM(totalcoursexpearned), 0) AS xp_total_semana,
    COUNTIF(is_completed = TRUE) AS cursos_concluidos_semana
  FROM base_cursos
  WHERE semana_inicio IS NOT NULL
  GROUP BY semana_inicio
),

metricas_trilhas AS (
  SELECT
    semana_inicio,
    COUNTIF(is_completed = TRUE) AS trilhas_concluidas_semana
  FROM base_trilhas
  WHERE semana_inicio IS NOT NULL
  GROUP BY semana_inicio
)

SELECT
  a.semana_inicio,
  a.alunos_ativos_semana,
  COALESCE(c.xp_total_semana, 0) AS xp_total_semana,
  ROUND(SAFE_DIVIDE(COALESCE(c.xp_total_semana, 0), a.alunos_ativos_semana), 2) AS media_xp_por_aluno_semana,
  COALESCE(c.cursos_concluidos_semana, 0) AS cursos_concluidos_semana,
  COALESCE(t.trilhas_concluidas_semana, 0) AS trilhas_concluidas_semana
FROM metricas_alunos a
LEFT JOIN metricas_cursos c
  ON a.semana_inicio = c.semana_inicio
LEFT JOIN metricas_trilhas t
  ON a.semana_inicio = t.semana_inicio
ORDER BY a.semana_inicio ASC
